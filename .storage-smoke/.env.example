# Copy this file to .storage-smoke/.env and set permissions to 0600.
# Use credentials restricted to a dedicated test bucket whenever possible.

# Run one provider at a time while configuring it; use "all" only after every
# provider section below is complete.
KEYMASTER_STORAGE_SMOKE_PROVIDER=all

# Optional prefix inside each configured bucket. Keep the trailing slash.
KEYMASTER_STORAGE_SMOKE_BASE_PREFIX=keymaster-tests/

# AWS S3
KEYMASTER_STORAGE_SMOKE_AWS_REGION=us-east-1
KEYMASTER_STORAGE_SMOKE_AWS_BUCKET=
KEYMASTER_STORAGE_SMOKE_AWS_ACCESS_KEY_ID=
KEYMASTER_STORAGE_SMOKE_AWS_SECRET_ACCESS_KEY=

# Cloudflare R2
KEYMASTER_STORAGE_SMOKE_R2_ACCOUNT_ID=
KEYMASTER_STORAGE_SMOKE_R2_ENDPOINT_VARIANT=default
KEYMASTER_STORAGE_SMOKE_R2_BUCKET=
KEYMASTER_STORAGE_SMOKE_R2_ACCESS_KEY_ID=
KEYMASTER_STORAGE_SMOKE_R2_SECRET_ACCESS_KEY=

# Generic S3-compatible service
KEYMASTER_STORAGE_SMOKE_COMPAT_ENDPOINT=
KEYMASTER_STORAGE_SMOKE_COMPAT_REGION=us-east-1
KEYMASTER_STORAGE_SMOKE_COMPAT_BUCKET=
KEYMASTER_STORAGE_SMOKE_COMPAT_FORCE_PATH_STYLE=true
KEYMASTER_STORAGE_SMOKE_COMPAT_ACCESS_KEY_ID=
KEYMASTER_STORAGE_SMOKE_COMPAT_SECRET_ACCESS_KEY=
