{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@keymaster/connect",
  "entryPoints": ["../../packages/connect/src/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "../../packages/connect/tsconfig.lib.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "out": "site/api",
  "docsRoot": "site",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "includeVersion": true,
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "sidebar": {
    "autoConfiguration": true,
    "format": "vitepress",
    "pretty": true,
    "collapsed": true
  }
}
