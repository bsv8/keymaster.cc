{
  "name": "keymaster",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @keymaster/web",
    "build": "npm run build -w @keymaster/web && node scripts/check-web-production-artifacts.mjs",
    "smoke:msfile-media-sw": "node scripts/smoke-msfile-media-sw.mjs",
    "verify:msfile-read-concurrency-pressure": "node scripts/msfile-read-concurrency-pressure.mjs",
    "typecheck": "tsc -b",
    "keys:balance": "node scripts/check-key-balances.mjs",
    "verify:woc-asset": "node scripts/verify-woc-asset-observation.mjs",
    "lint:storage-naming": "node scripts/check-storage-hard-switch.mjs",
    "lint:boundaries": "node scripts/check-storage-hard-switch.mjs && node scripts/check-boundaries.mjs",
    "lint:react-boundaries": "node scripts/check-react-resource-boundaries.mjs",
    "test": "pnpm lint:react-boundaries && node scripts/run-vitest-batches.mjs",
    "test:storage:smoke": "vitest run --config vitest.storage-smoke.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "docs:connect:dev": "pnpm --filter @keymaster/connect-docs dev",
    "docs:connect:build": "pnpm --filter @keymaster/connect-docs build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "3.2.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@bsv/sdk": "^1.10.4",
    "@noble/curves": "^2.2.0",
    "i18next": "^23.16.8",
    "keymaster-multisig-pool": "^1.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-router": "^7.17.0"
  }
}
