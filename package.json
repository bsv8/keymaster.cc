{
  "name": "keymaster",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "config": {
    "webloomFrameworkReleaseVersion": "0.6.0"
  },
  "workspaces": [
    "packages/*",
    "coding/keymaster/vaultlink-integration",
    "coding/keymaster/vaultlink-sdk",
    "coding/keymaster/p2p-host"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:types && vite build && node scripts/check-web-production-artifacts.mjs",
    "build:production": "node scripts/build-plugin-lifecycle.mjs",
    "verify:final-io-audit": "node scripts/check-coordinator-final-io-audit.mjs",
    "verify:lifecycle-deployment": "node scripts/check-plugin-lifecycle-deployment.mjs",
    "prepare:lifecycle-evidence": "node scripts/prepare-plugin-lifecycle-evidence.mjs",
    "verify:lifecycle-production-gates": "node scripts/check-plugin-lifecycle-production-gates.mjs",
    "typecheck": "pnpm --filter keymaster.cc-download-scheduler build && pnpm --filter @keymaster/vaultlink-integration build && tsc -b",
    "check:contracts": "node scripts/check-contracts.mjs",
    "keys:balance": "node scripts/check-key-balances.mjs",
    "verify:woc-asset": "node scripts/verify-woc-asset-observation.mjs",
    "lint:storage-naming": "node scripts/check-storage-hard-switch.mjs",
    "lint:worker-boundaries": "node scripts/check-coordinator-worker-boundaries.mjs",
    "lint:boundaries": "node scripts/check-storage-hard-switch.mjs && node scripts/check-boundaries.mjs && pnpm lint:worker-boundaries && node scripts/check-coordinator-final-io-audit.mjs",
    "lint:webloom-release": "node scripts/check-webloom-release-boundary.mjs",
    "verify:webloom-registry": "node scripts/check-webloom-registry-consumer.mjs",
    "lint:react-boundaries": "node scripts/check-react-resource-boundaries.mjs",
    "generate:plugin-catalog": "node scripts/materialize-plugin-catalog.mjs --write && node scripts/generate-plugin-function-dependencies.mjs",
    "check:plugin-catalog": "node scripts/materialize-plugin-catalog.mjs && node scripts/generate-plugin-function-dependencies.mjs --check",
    "generate:plugin-dependencies": "node scripts/generate-plugin-function-dependencies.mjs",
    "check:plugin-dependencies": "node scripts/generate-plugin-function-dependencies.mjs --check",
    "check:types": "pnpm check:plugin-catalog && pnpm typecheck && pnpm check:contracts && pnpm lint:worker-boundaries",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@noble/secp256k1": "^2.2.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "@bsv/sdk": "^1.10.4",
    "@noble/curves": "^2.2.0",
    "i18next": "^23.16.8",
    "keymaster-multisig-pool": "^1.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-router": "^7.17.0",
    "@keymaster/contracts": "*",
    "@keymaster/msfile-media": "*",
    "@keymaster/platform-storage": "*",
    "@keymaster/plugin-apps": "*",
    "@keymaster/plugin-background": "*",
    "@keymaster/plugin-bsv-price": "*",
    "@keymaster/plugin-contacts": "*",
    "@keymaster/plugin-forum": "*",
    "@keymaster/plugin-message": "*",
    "@keymaster/plugin-msfile": "*",
    "@keymaster/plugin-p2pkh": "*",
    "@keymaster/plugin-protocol": "*",
    "@keymaster/plugin-sat-subscription": "*",
    "@keymaster/plugin-vault": "*",
    "@keymaster/plugin-webrtc": "*",
    "@keymaster/plugin-window-p2p": "*",
    "@keymaster/plugin-woc": "*",
    "@keymaster/runtime": "*",
    "@keymaster/ui": "*",
    "@libp2p/webrtc": "6.0.30",
    "@libp2p/websockets": "10.1.20",
    "@multiformats/multiaddr": "13.0.3",
    "@noble/hashes": "^1.8.0",
    "bitcoin-libp2p": "0.3.1",
    "bsv8-channel-protocol": "0.6.0",
    "go-bitfs": "0.5.0",
    "buffer": "^6.0.3",
    "keyhold": "2.1.0",
    "sat-subscription-protocol": "0.3.0",
    "webloom-framework": "0.6.0",
    "@keymaster/plugin-page": "*",
    "@keymaster/plugin-scan": "workspace:*"
  },
  "description": "本地优先的 BSV 浏览器钱包。基于插件架构，按\"基础设施 / 平台 / 业务\"三层分离。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv8/keymaster.cc.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bsv8/keymaster.cc/issues"
  },
  "homepage": "https://github.com/bsv8/keymaster.cc#readme"
}
