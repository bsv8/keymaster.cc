{
  "name": "@keymaster/vaultlink-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "default": "./dist/ui.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./migration": {
      "types": "./dist/migration-journal.d.ts",
      "import": "./dist/migration-journal.js",
      "default": "./dist/migration-journal.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@keymaster/contracts": "workspace:*",
    "@vaultlink/sdk": "workspace:0.2.0-draft.1",
    "@keymaster/ui": "workspace:*",
    "react": "^18.3.1",
    "bsv8-channel-protocol": "0.6.0"
  },
  "devDependencies": {
    "go-bitfs": "0.3.3",
    "@libp2p/websockets": "10.1.20",
    "@keymaster/p2p-host": "workspace:*",
    "@multiformats/multiaddr": "13.0.3"
  }
}
